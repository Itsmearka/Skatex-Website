# Optional: Prismic repo domain override (defaults to go84va8p in src/lib/prismicio.js)
PUBLIC_PRISMIC_REPO=go84va8p

# Ops only — Prismic Write APIs (Custom Types API + Migration API). Never read by the app.
# Manage via Doppler instead: doppler secrets set PRISMIC_WRITE_TOKEN="..." -p skatex -c dev
PRISMIC_WRITE_TOKEN=
